VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN long_wire ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 4000000 28000 ) ;
ROW ROW_0 core 0 0 N DO 10000 BY 1 STEP 400 0 ;
COMPONENTS 2 ;
    - drv BUF_X1 + PLACED ( 20000 0 ) N ;
    - load BUF_X1 + PLACED ( 3820000 0 ) N ;
END COMPONENTS
PINS 2 ;
    - in1 + NET in1 + DIRECTION INPUT + USE SIGNAL
      + LAYER M1 ( -100 -100 ) ( 100 100 ) + PLACED ( 200 1400 ) N ;
    - out1 + NET out1 + DIRECTION OUTPUT + USE SIGNAL
      + LAYER M1 ( -100 -100 ) ( 100 100 ) + PLACED ( 3999800 1400 ) N ;
END PINS
NETS 3 ;
    - in1 ( PIN in1 ) ( drv A ) + USE SIGNAL ;
    - n1 ( drv Z ) ( load A ) + USE SIGNAL ;
    - out1 ( load Z ) ( PIN out1 ) + USE SIGNAL ;
END NETS
END DESIGN
